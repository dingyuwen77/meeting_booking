# 会畅智云账号模式 API（真实值只在服务器环境注入）
MEETING_SITE_SIGN=
MEETING_API_KEY=
MEETING_BIZVIDEO_BASE_URL=https://apinext.bizvideo.cn/openapi/v1
MEETING_DEFAULT_PARTIES=25
MEETING_HTTP_TIMEOUT=10

# 企微 CorpID 与可信网关和本服务共享的 HMAC 密钥（建议随机 >=32 字符）
MEETING_CORP_ID=
MEETING_IDENTITY_SECRET=

# 单机持久化；数据目录必须挂载持久卷。默认禁止真实写入。
MEETING_DB_PATH=./data/meeting_booking.sqlite3
MEETING_WRITE_ENABLED=false
MEETING_MCP_HOST=127.0.0.1
MEETING_MCP_PORT=4561
