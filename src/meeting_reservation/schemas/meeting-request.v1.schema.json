{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adp-meeting:contract:meeting-request:v1",
  "title": "MCP 提交会议请求 V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "intent"
  ],
  "properties": {
    "schema_version": {
      "const": "meeting.request.v1"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[A-Za-z0-9_-]{8,96}$"
    },
    "intent": {
      "$ref": "urn:adp-meeting:contract:meeting-intent:v1"
    }
  }
}
